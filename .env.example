# ==============================================================================
# PINJAM Environment Variables (.env.example)
# Salin file ini menjadi .env.local untuk pengembangan lokal.
# JANGAN PERNAH mengisi nilai kredensial nyata atau rahasia ke dalam repositori Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Kredensial Publik Supabase (Dapat diakses oleh browser/client)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-placeholder"

# ------------------------------------------------------------------------------
# 2. Kredensial Server-Only Supabase (DILARANG KERAS diekspos ke browser/client)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"

# ------------------------------------------------------------------------------
# 3. Rahasia Penandatanganan Token QR Pass (HS256, Server-Only)
# Minimum 32 karakter acak kriptografis (256-bit).
# DILARANG menggunakan Supabase Secret sebagai QR_TOKEN_SECRET.
# ------------------------------------------------------------------------------
QR_TOKEN_SECRET="your-qr-token-secret-minimum-32-characters-placeholder"

# ------------------------------------------------------------------------------
# 4. Rahasia Vercel Cron Retention (Server-Only)
# Digunakan untuk otentikasi tugas terjadwal pembersihan retensi data harian.
# ------------------------------------------------------------------------------
CRON_SECRET="your-cron-secret-placeholder"

